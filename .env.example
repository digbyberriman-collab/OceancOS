# PostgreSQL. Chosen before Phase 1 triples the table count, for real JSON
# columns and proper concurrency. Locally: createdb oceancos.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/oceancos?schema=public"
SESSION_SECRET="change-me-to-a-long-random-string"

# ---- File storage ----
# Required — left blank here deliberately. The app refuses to serve or accept
# an upload until this is set explicitly; nothing is inferred from whether
# S3_BUCKET happens to be set.
# "local" writes under ./uploads — development and CI only. Those files do
# NOT survive a restart or a redeploy; do not use this in any deployment
# whose disk is not permanent.
# "s3" targets any S3-compatible service; Cloudflare R2 is the chosen
# provider. Every deployment other than local development or CI must use
# this, with the S3_* block below filled in.
STORAGE_DRIVER=
UPLOAD_DIR="./uploads"
MAX_UPLOAD_BYTES=26214400

# Cloudflare R2: endpoint is https://<account-id>.r2.cloudflarestorage.com
# AWS S3: leave S3_ENDPOINT empty and set a real S3_REGION.
# MinIO: set S3_ENDPOINT to your server.
S3_BUCKET=
S3_REGION="auto"
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional public/custom domain for the bucket. When set, downloads use it
# directly instead of a signed URL.
S3_PUBLIC_BASE_URL=

# ---- PDF export ----
# PDFs are produced by printing the real page in headless Chromium, so the
# server needs a browser. Point at the binary, or name an installed channel.
PLAYWRIGHT_CHROMIUM_PATH=
PDF_CHROME_CHANNEL=
# Absolute URL the PDF renderer navigates back to. Required behind a proxy.
APP_URL=

# ---- Outbound notifications ----
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="OceancOS <noreply@oceancos.local>"
# Where the development "outbox" transport writes messages when SMTP_HOST is
# unset — one JSON file per message. The e2e suite reads this directory to
# find the emails it asserts on (e2e/jobs.spec.ts, e2e/passwordReset.spec.ts).
MAIL_OUTBOX_DIR="./.mail"

# ---- Seeding ----
# Password given to every seeded account. Development and test fall back to
# "password" so the fixtures and the e2e suite can sign in; production has no
# fallback and the seed refuses to run without this set.
SEED_PASSWORD=

# ---- Testing ----
# Port the e2e suite's own server binds to and hits (playwright.config.ts).
# Only needed if the default is already in use on your machine.
# E2E_PORT=3210

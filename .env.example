# PostgreSQL. Chosen before Phase 1 triples the table count, for real JSON
# columns and proper concurrency. Locally: createdb oceancos.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/oceancos?schema=public"
SESSION_SECRET="change-me-to-a-long-random-string"

# ---- File storage ----
# "local" writes under ./uploads (development and CI).
# "s3" targets any S3-compatible service; Cloudflare R2 is the chosen provider.
# REQUIRED in production — the app refuses to start without it set. Outside
# production it's fine to leave unset: it's inferred as s3 when S3_BUCKET is
# present, otherwise local. That inference is deliberately not trusted in
# production: local disk is ephemeral on most deployment platforms, so a
# bucket left unconfigured would silently lose every upload rather than fail
# loudly at startup.
STORAGE_DRIVER=
UPLOAD_DIR="./uploads"
MAX_UPLOAD_BYTES=26214400

# Cloudflare R2: endpoint is https://<account-id>.r2.cloudflarestorage.com
# AWS S3: leave S3_ENDPOINT empty and set a real S3_REGION.
# MinIO: set S3_ENDPOINT to your server.
S3_BUCKET=
S3_REGION="auto"
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional public/custom domain for the bucket. When set, downloads use it
# directly instead of a signed URL.
S3_PUBLIC_BASE_URL=

# ---- PDF export ----
# PDFs are produced by printing the real page in headless Chromium, so the
# server needs a browser. Point at the binary, or name an installed channel.
PLAYWRIGHT_CHROMIUM_PATH=
PDF_CHROME_CHANNEL=
# Absolute URL the PDF renderer navigates back to. Required behind a proxy.
APP_URL=

# ---- Outbound notifications ----
# With no SMTP_HOST, email is written as JSON files instead of sent — the
# outbox both the app and the e2e suite read from. Never used outside
# development/test; a real deployment sets SMTP_HOST and the rest below it.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="OceancOS <noreply@oceancos.local>"
# Where the file outbox is written. Defaults to ./.mail.
MAIL_OUTBOX_DIR=

# ---- End-to-end tests ----
# Port playwright.config.ts starts the app on for the e2e suite. Defaults to
# 3210; only needed if that port is already in use.
E2E_PORT=

# ---- Seeding ----
# Password given to every seeded account. Development and test fall back to
# "password" so the fixtures and the e2e suite can sign in; production has no
# fallback and the seed refuses to run without this set.
SEED_PASSWORD=

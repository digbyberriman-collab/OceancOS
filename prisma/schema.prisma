// OceancOS schema. PostgreSQL, chosen before Phase 1 triples the table count
// (BRIDGE_ALIGNMENT_PLAN.md §7 decision 6).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identity & access ----------

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  archivedAt   DateTime?

  roles        UserRole[]
  sessions     Session[]
  notifications Notification[]
  passwordResets PasswordReset[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  // Project the user is currently working in — drives the header switcher.
  activeProjectId String?
  user      User     @relation(fields: [userId], references: [id])
  activeProject Project? @relation("ActiveSessions", fields: [activeProjectId], references: [id])
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique // e.g. "CAPTAIN"
  name        String
  description String?
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id    String           @id @default(cuid())
  key   String           @unique // e.g. "change_order.approve.finance"
  label String
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model UserRole {
  id           String   @id @default(cuid())
  userId       String
  roleId       String
  vesselId     String?
  projectId    String?
  departmentId String?
  user         User     @relation(fields: [userId], references: [id])
  role         Role     @relation(fields: [roleId], references: [id])
  vessel       Vessel?  @relation(fields: [vesselId], references: [id])
  project      Project? @relation(fields: [projectId], references: [id])
  department   Department? @relation(fields: [departmentId], references: [id])
}

// ---------- Org / project ----------

model Vessel {
  id         String     @id @default(cuid())
  name       String
  imo        String?
  flag       String?
  loa        Float?
  builtYear  Int?
  notes      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  archivedAt DateTime?
  projects   Project[]
  areas      VesselArea[]
  userRoles  UserRole[]
}

model Project {
  id            String         @id @default(cuid())
  vesselId      String
  name          String
  // Short project code shown in the header, e.g. "R-00721".
  code          String?        @unique
  type          String         // REFIT | NEW_BUILD | CONVERSION
  status        String         @default("ACTIVE")
  startDate     DateTime?
  targetEndDate DateTime?
  // Yard period — drives the Home timing cards and the time-progress ring.
  yardName      String?
  arrivalDate   DateTime?
  haulOutDate   DateTime?
  seaTrialsDate DateTime?
  departureDate DateTime?
  currency      String         @default("EUR")
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  archivedAt    DateTime?
  vessel        Vessel         @relation(fields: [vesselId], references: [id])
  changeOrders  ChangeOrder[]
  crewRequests  CrewRequest[]
  budgets       Budget[]
  tasks         ScheduleTask[]
  milestones    Milestone[]
  logistics     LogisticsItem[]
  drawings      Drawing[]
  documents     Document[]
  meetings      Meeting[]
  risks         Risk[]
  inventory     InventoryItem[]
  userRoles     UserRole[]
  approvals     Approval[]
  activeSessions Session[]     @relation("ActiveSessions")
  jobs          Job[]
  jobSections   JobSection[]
}

model Department {
  id        String        @id @default(cuid())
  name      String        @unique
  code      String?
  userRoles UserRole[]
}

model VesselArea {
  id       String   @id @default(cuid())
  vesselId String
  name     String   // e.g. "Engine Room", "Owner's Suite"
  code     String?
  vessel   Vessel   @relation(fields: [vesselId], references: [id])
}

// ---------- Change orders ----------

model ChangeOrder {
  id              String   @id @default(cuid())
  projectId       String
  number          String   @unique // CO-0001
  title           String
  description     String
  reason          String
  departmentCode  String?
  vesselAreaId    String?
  status          String   @default("DRAFT") // DRAFT|SUBMITTED|UNDER_REVIEW|MORE_INFO|APPROVED|REJECTED|IN_PROGRESS|COMPLETED|CLOSED|CANCELLED
  priority        String   @default("MEDIUM")
  estimatedCost   Float    @default(0)
  approvedCost    Float?
  scheduleImpactDays Int   @default(0)
  riskImpact      String?
  technicalImpact String?
  needsClassReview  Boolean @default(false)
  needsFlagReview   Boolean @default(false)
  createdAt       DateTime @default(now())
  createdById     String
  updatedAt       DateTime @updatedAt
  updatedById     String?
  archivedAt      DateTime?

  project       Project @relation(fields: [projectId], references: [id])
  approvals     ChangeOrderApproval[]
  history       ChangeOrderHistory[]
  comments      Comment[]
  attachments   Attachment[]
  crewRequests  CrewRequest[]
  jobs          Job[]
}

model ChangeOrderApproval {
  id            String   @id @default(cuid())
  changeOrderId String
  stage         String   // CAPTAIN|OWNERS_REP|YARD|FINANCE|TECH_MANAGER|CLASS|FLAG
  decision      String   @default("PENDING") // PENDING|APPROVED|REJECTED|MORE_INFO|DELEGATED
  decidedById   String?
  decidedAt     DateTime?
  comment       String?
  required      Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  changeOrder   ChangeOrder @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)
}

model ChangeOrderHistory {
  id            String   @id @default(cuid())
  changeOrderId String
  actorId       String
  event         String
  fromStatus    String?
  toStatus      String?
  details       String?
  createdAt     DateTime @default(now())
  changeOrder   ChangeOrder @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)
}

// ---------- Crew requests ----------

model CrewRequest {
  id              String   @id @default(cuid())
  projectId       String
  number          String   @unique // REQ-0001
  title           String
  description     String
  category        String   // DEFECT|OPERATIONAL|SAFETY|INTERIOR|ENGINEERING|DECK|IT|PROCUREMENT|ACCOMMODATION|ACCESS|CLEANING
  departmentCode  String?
  vesselAreaId    String?
  priority        String   @default("MEDIUM")
  status          String   @default("NEW") // NEW|TRIAGED|ASSIGNED|IN_PROGRESS|BLOCKED|AWAITING_APPROVAL|COMPLETED|REJECTED|CLOSED
  requestedById   String
  assignedToId    String?
  dueDate         DateTime?
  costImpact      Float    @default(0)
  scheduleImpactDays Int   @default(0)
  safetyImpact    String?
  linkedChangeOrderId String?
  createdAt       DateTime @default(now())
  createdById     String
  updatedAt       DateTime @updatedAt
  updatedById     String?
  archivedAt      DateTime?

  project          Project       @relation(fields: [projectId], references: [id])
  linkedChangeOrder ChangeOrder? @relation(fields: [linkedChangeOrderId], references: [id])
  comments         Comment[]
  attachments      Attachment[]
}

// ---------- Generic approvals queue ----------

model Approval {
  id          String   @id @default(cuid())
  projectId   String?
  resource    String   // CHANGE_ORDER|CREW_REQUEST|PURCHASE_ORDER|DRAWING|BUDGET_CHANGE|SCHEDULE_CHANGE|ACCESS|SUBSTITUTION|VARIATION|FINAL_ACCEPTANCE
  resourceId  String
  stage       String
  status      String   @default("PENDING")
  requesterId String
  approverId  String?
  costImpact  Float    @default(0)
  scheduleImpactDays Int @default(0)
  dueDate     DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  decidedAt   DateTime?
  project     Project? @relation(fields: [projectId], references: [id])
}

// ---------- Financials ----------

model BudgetCategory {
  id      String  @id @default(cuid())
  name    String  @unique
  parentId String?
  parent   BudgetCategory? @relation("BC", fields: [parentId], references: [id])
  children BudgetCategory[] @relation("BC")
  budgets  Budget[]
}

model CostCode {
  id      String @id @default(cuid())
  code    String @unique
  name    String
}

model Budget {
  id            String   @id @default(cuid())
  projectId     String
  categoryId    String
  departmentCode String?
  originalAmount Float    @default(0)
  approvedChanges Float   @default(0)
  pendingChanges  Float   @default(0)
  committed       Float   @default(0)
  actual          Float   @default(0)
  forecastFinal   Float   @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  project       Project  @relation(fields: [projectId], references: [id])
  category      BudgetCategory @relation(fields: [categoryId], references: [id])
}

model Supplier {
  id        String  @id @default(cuid())
  name      String  @unique
  contact   String?
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  archivedAt DateTime?
  invoices  Invoice[]
  pos       PurchaseOrder[]
}

model PurchaseOrder {
  id          String   @id @default(cuid())
  number      String   @unique
  supplierId  String
  projectId   String?
  amount      Float
  status      String   @default("DRAFT") // DRAFT|SUBMITTED|APPROVED|REJECTED|RECEIVED|CLOSED
  description String?
  costCodeId  String?
  createdAt   DateTime @default(now())
  createdById String
  supplier    Supplier @relation(fields: [supplierId], references: [id])
}

model Invoice {
  id         String   @id @default(cuid())
  number     String
  supplierId String
  poId       String?
  amount     Float
  status     String   @default("RECEIVED") // RECEIVED|APPROVED|REJECTED|PAID
  dueDate    DateTime?
  createdAt  DateTime @default(now())
  supplier   Supplier @relation(fields: [supplierId], references: [id])
}

// ---------- Schedule ----------

model ScheduleTask {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  ownerId     String?
  startDate   DateTime?
  endDate     DateTime?
  status      String   @default("PLANNED") // PLANNED|IN_PROGRESS|BLOCKED|DONE|CANCELLED
  dependsOnId String?
  riskLevel   String   @default("LOW")
  blockers    String?
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id])
  dependsOn   ScheduleTask? @relation("Dep", fields: [dependsOnId], references: [id])
  blocked     ScheduleTask[] @relation("Dep")
}

model Milestone {
  id        String   @id @default(cuid())
  projectId String
  name      String
  date      DateTime
  type      String   // YARD_PERIOD|SEA_TRIAL|HAT|SAT|CLASS_INSPECTION|FLAG_INSPECTION|DELIVERY|CUSTOM
  status    String   @default("PENDING")
  project   Project  @relation(fields: [projectId], references: [id])
}

// ---------- Logistics ----------

model LogisticsItem {
  id          String   @id @default(cuid())
  projectId   String
  type        String   // CREW_TRAVEL|CONTRACTOR_TRAVEL|YARD_ACCESS|DELIVERY|SHIPMENT|CUSTOMS|COURIER|ACCOMMODATION|TRANSPORT|CRANE|DOCK|TUG|PILOT|LINESMEN|BUNKERING|WASTE|PROVISIONING|GUEST
  whenAt      DateTime?
  responsibleId String?
  status      String   @default("PLANNED")
  supplierId  String?
  cost        Float    @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id])
}

// ---------- Inventory ----------

model InventoryItem {
  id           String  @id @default(cuid())
  projectId    String?
  name         String
  category     String  // EQUIPMENT|SPARE|CRITICAL_SPARE|TOOL|CONSUMABLE|LSA|FFE|AV_IT|ENGINEERING|DECK|INTERIOR|GALLEY|MEDICAL|DIVE|SAFETY
  departmentCode String?
  location     String?
  qty          Int     @default(0)
  manufacturer String?
  model        String?
  serial       String?
  supplierId   String?
  warranty     String?
  certificate  String?
  maintenance  String?
  replacementCost Float @default(0)
  status       String  @default("OK") // OK|LOW|REORDER|MISSING|FAULTY|RETIRED
  minStock     Int     @default(0)
  reorderTrigger Int   @default(0)
  createdAt    DateTime @default(now())
  archivedAt   DateTime?
  project      Project? @relation(fields: [projectId], references: [id])
}

// ---------- Drawings & docs ----------

model Drawing {
  id        String   @id @default(cuid())
  projectId String
  number    String   @unique
  title     String
  status    String   @default("DRAFT") // DRAFT|SUBMITTED|UNDER_REVIEW|COMMENTS|REVISED|APPROVED|APPROVED_W_COMMENTS|REJECTED|SUPERSEDED|ARCHIVED
  vesselAreaId String?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])
  revisions DrawingRevision[]
}

model DrawingRevision {
  id        String   @id @default(cuid())
  drawingId String
  rev       String
  fileUrl   String?
  notes     String?
  current   Boolean  @default(false)
  createdAt DateTime @default(now())
  drawing   Drawing  @relation(fields: [drawingId], references: [id], onDelete: Cascade)
}

model Document {
  id         String   @id @default(cuid())
  projectId  String?
  name       String
  type       String   // CONTRACT|SPEC|DRAWING|CERT|CLASS|FLAG|MANUAL|WARRANTY|QUOTE|INVOICE|PO|RA|MS|MINUTES|REPORT|OTHER
  folder     String?
  tags       String?
  fileUrl    String?
  ownerId    String?
  expiresAt  DateTime?
  reviewAt   DateTime?
  approvalStatus String @default("DRAFT")
  createdAt  DateTime @default(now())
  archivedAt DateTime?
  project    Project? @relation(fields: [projectId], references: [id])
}

// ---------- Contractors ----------

model Contractor {
  id        String  @id @default(cuid())
  name      String  @unique
  trade     String?
  contact   String?
  email     String?
  phone     String?
  contractValue Float @default(0)
  insuranceExpiresAt DateTime?
  notes     String?
  createdAt DateTime @default(now())
  archivedAt DateTime?
}

// ---------- Meetings ----------

model Meeting {
  id        String   @id @default(cuid())
  projectId String
  title     String
  type      String   // OWNERS|YARD|TECH|INTERIOR|CLASS_FLAG|FINANCE|HOD|CONTRACTOR
  meetsAt   DateTime
  location  String?
  agenda    String?
  minutes   String?
  attendees String?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])
  actions   MeetingAction[]
}

model MeetingAction {
  id        String   @id @default(cuid())
  meetingId String
  text      String
  ownerId   String?
  dueDate   DateTime?
  status    String   @default("OPEN")
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

// ---------- Risks ----------

model Risk {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?
  category    String   @default("GENERAL")
  likelihood  Int      @default(1) // 1-5
  impact      Int      @default(1) // 1-5
  rating      Int      @default(1) // computed = L*I
  mitigation  String?
  ownerId     String?
  dueDate     DateTime?
  status      String   @default("OPEN") // OPEN|MITIGATED|ACCEPTED|CLOSED|ESCALATED
  costImpact  Float    @default(0)
  scheduleImpactDays Int @default(0)
  safetyImpact String?
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id])
}

// ---------- Notifications ----------

model Notification {
  id          String   @id @default(cuid())
  userId      String
  kind        String
  priority    String   @default("MEDIUM")
  title       String
  body        String?
  resource    String?
  resourceId  String?
  readAt      DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

// ---------- Comments / attachments ----------

model Comment {
  id            String   @id @default(cuid())
  authorId      String
  body          String
  resource      String
  resourceId    String
  changeOrderId String?
  crewRequestId String?
  jobId         String?
  /// MESSAGE is an ordinary comment; MINUTE is tagged as a meeting minute;
  /// SYSTEM records a lifecycle event in the same thread.
  kind          String   @default("MESSAGE")
  createdAt     DateTime @default(now())
  changeOrder   ChangeOrder? @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)
  crewRequest   CrewRequest? @relation(fields: [crewRequestId], references: [id], onDelete: Cascade)
  job           Job?         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  attachments   Attachment[]

  @@index([jobId])
}

model Attachment {
  id            String   @id @default(cuid())
  uploaderId    String
  filename      String
  mimetype      String?
  size          Int      @default(0)
  // Object key in the storage bucket. `url` stays for externally hosted files
  // recorded before object storage existed.
  storageKey    String?
  url           String?
  resource      String
  resourceId    String
  changeOrderId String?
  crewRequestId String?
  jobId         String?
  commentId     String?
  createdAt     DateTime @default(now())
  changeOrder   ChangeOrder? @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)
  crewRequest   CrewRequest? @relation(fields: [crewRequestId], references: [id], onDelete: Cascade)
  job           Job?         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  comment       Comment?     @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([commentId])
}

// ---------- Audit ----------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String   // CREATE|UPDATE|DELETE|APPROVE|REJECT|STATUS|COMMENT|UPLOAD|LOGIN|LOGOUT
  resource   String
  resourceId String?
  details    Json?
  createdAt  DateTime @default(now())
}

// ---------- Password reset ----------

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  // Only the hash is stored, so a database leak yields no usable links.
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


// ---------- Jobs & quotes ----------
//
// The commercial record with the yard, and the core object of the yard portal.
// A ChangeOrder is the owner-side governance record — why scope is changing and
// who internally approves it. A Job is what the yard quotes, the client accepts
// and the yard invoices. They link one-to-many: a change order can authorise
// several jobs, and a job records which change order authorised it.

model JobSection {
  id        String  @id @default(cuid())
  projectId String
  /// Section letter in the yard's code system, e.g. "D" for Dry Dock.
  letter    String
  name      String
  sort      Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  jobs      Job[]

  @@unique([projectId, letter])
}

model Job {
  id           String  @id @default(cuid())
  projectId    String
  sectionId    String?
  /// Yard job code, e.g. "D.0130.05". Unique within a project.
  code         String
  /// Group the code belongs to, e.g. "D.0130". Derived, stored for grouping.
  groupCode    String?
  /// The yacht's own tracking number, when they use one.
  clientRef    String?
  title        String
  description  String

  contractType String  @default("VARIATION_CERTIFICATE") // CONTRACT|VARIATION_CERTIFICATE|SERVICES|PURCHASE
  pricingBasis String  @default("FIXED")                 // FIXED|ESTIMATED|TIME_AND_MATERIALS
  exceptionFlag Boolean @default(false)

  status       String  @default("NEW_REQUEST")
  // NEW_REQUEST|QUOTE_SENT|CLIENT_ACCEPTED|ACCEPTED|EXPIRED|CANCELLED_QUOTE|
  // CANCELLED_WORKS|YARD_COMPLETED|WORKS_ACCEPTED|MINOR_DEFICIENCY|CLOSED

  total        Float   @default(0)
  currency     String  @default("EUR")
  /// Yard-reported completion, 0–100.
  progressPct  Int     @default(0)

  requestedAt      DateTime?
  quoteDeliveredAt DateTime?
  validityDays     Int?
  /// quoteDeliveredAt + validityDays. Stored so expiry can be queried.
  expiresAt        DateTime?

  clientAcceptedAt   DateTime?
  clientAcceptedById String?
  yardAcceptedAt     DateTime?
  yardAcceptedById   String?
  cancelledAt        DateTime?
  cancelReason       String?
  yardCompletedAt    DateTime?
  /// When works were accepted by the client. The warranty starts here.
  worksAcceptedAt    DateTime?
  warrantyMonths     Int?

  designatedAuthoriserId String?
  linkedChangeOrderId    String?

  createdAt   DateTime  @default(now())
  createdById String
  updatedAt   DateTime  @updatedAt
  updatedById String?
  archivedAt  DateTime?

  project     Project        @relation(fields: [projectId], references: [id])
  section     JobSection?    @relation(fields: [sectionId], references: [id])
  changeOrder ChangeOrder?   @relation(fields: [linkedChangeOrderId], references: [id])
  lines       JobLine[]
  notes       JobNote[]
  variation   JobVariation?
  history     JobHistory[]
  favourites  JobFavourite[]
  comments    Comment[]
  attachments Attachment[]
  challenges  AcceptanceChallenge[]

  @@unique([projectId, code])
  @@index([projectId, status])
  @@index([projectId, groupCode])
}

model JobLine {
  id          String @id @default(cuid())
  jobId       String
  sort        Int    @default(0)
  description String
  quantity    Float  @default(1)
  unit        String @default("UN")
  unitPrice   Float  @default(0)
  /// quantity × unitPrice, stored so a historic quote keeps the figure it was
  /// accepted at even if the arithmetic convention ever changes.
  total       Float  @default(0)
  job         Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model JobNote {
  id    String @id @default(cuid())
  jobId String
  kind  String // EXCLUSION|NOTE
  sort  Int    @default(0)
  text  String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, kind])
}

/// Variation certificate detail, present only on a variation.
model JobVariation {
  id                 String  @id @default(cuid())
  jobId              String  @unique
  dueTo              String? // OWNER_REQUEST|YARD_FINDING|CLASS_REQUIREMENT|SURVEY_FINDING|OTHER
  affecting          String? // WORKS_SPECIFICATION|DELIVERY_DATE|CONTRACT_PRICE|OTHER
  deliveryAdjustment String?
  priceAdjustment    Float?
  /// Staged invoicing terms, e.g. 50% on signature and 50% on completion.
  invoicingTerms     Json?
  job                Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model JobHistory {
  id         String   @id @default(cuid())
  jobId      String
  actorId    String?
  event      String
  fromStatus String?
  toStatus   String?
  details    Json?
  createdAt  DateTime @default(now())
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

/// A pending acceptance: the code sent to the authoriser and what it signs.
model AcceptanceChallenge {
  id        String    @id @default(cuid())
  jobId     String
  userId    String
  /// Only the hash is stored, bound to this challenge so a code cannot be replayed.
  codeHash  String
  channel   String    @default("EMAIL") // EMAIL|SMS
  /// Fingerprint of the quote at the moment the code was sent, so an alteration
  /// between sending and signing is detectable.
  quoteHash String
  attempts  Int       @default(0)
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime  @default(now())
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, userId])
}

model JobFavourite {
  userId    String
  jobId     String
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([userId, jobId])
}

// ---------- Settings ----------

model Setting {
  key   String @id
  value String
}
